# Maintainer: Mehmet Karaca <karacamemo1 at gmail dot com>
pkgname=micforge-bin
_pkgname=micforge
pkgver=0.1.0
pkgrel=1
pkgdesc="Real-time microphone processing TUI for PipeWire (prebuilt binary)"
arch=('x86_64')
url="https://github.com/Shidori5417/micforge"
license=('GPL-3.0-or-later')
depends=('pipewire' 'wireplumber' 'gcc-libs' 'glibc')
provides=("$_pkgname=$pkgver")
conflicts=("$_pkgname")
source=("$url/releases/download/v$pkgver/$_pkgname-$pkgver-x86_64-linux.tar.gz")
sha256sums=('880ca3478f87e7b213397d354a5b657a130b096c6043059b8e592844ff27fb21')

package() {
  cd "$_pkgname-$pkgver-x86_64-linux"
  install -Dm755 micforge "$pkgdir/usr/bin/micforge"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md README.en.md -t "$pkgdir/usr/share/doc/$pkgname/"
}
